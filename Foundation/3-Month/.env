# ============================================================
#  .env.example — nusxa olib «.env» deb nomlang:
#      cp .env.example .env
#  Keyin qiymatlarni to'ldiring.
# ============================================================

# @BotFather'dan olingan token (majburiy)
# Ko'rinishi: 9091335429:AAGKSpLxxhJLOKgmDNW0sgtzXHBTkUt0lyI
BOT_TOKEN=9091335429:AAGKSpLxxhJLOKgmDNW0sgtzXHBTkUt0lyI

# Admin Telegram ID'lari, vergul bilan (majburiy)
# O'z ID'ingizni @userinfobot orqali bilib oling
# Ko'rinishi: 9091335429
ADMIN_IDS=9091335429

# --- Narx ---
# Sovg'a narxiga qo'shiladigan ustama (foiz)
MARKUP_PERCENT=20
# Minimal ustama (Stars). Masalan 15 ⭐ sovg'aga 20% = 3 ⭐
MIN_MARKUP=3

# 1 Stars ≈ necha so'm (faqat ko'rsatish uchun, to'lov Stars'da)
STARS_TO_SOM=280
# Narx yonida «≈ so'm» ko'rsatilsinmi (1 = ha, 0 = yo'q)
SHOW_SOM_ESTIMATE=1

# --- Buyurtma ---
# Sovg'a havolasi necha kun amal qiladi
CLAIM_TTL_DAYS=7
# Necha daqiqada bir marta muddati o'tganlarni tekshirish
EXPIRE_CHECK_MINUTES=30

# --- Baza (bo'sh qoldirsangiz, loyiha papkasida orders.db) ---
# DB_PATH=/full/path/orders.db

# --- Aloqa ---
SUPPORT_CONTACT=@your_support

# --- Log ---
LOG_LEVEL=INFO
